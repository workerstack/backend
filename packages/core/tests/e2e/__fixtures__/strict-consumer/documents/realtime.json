{
  "info": { "title": "Strict Realtime", "version": "1.0.0" },
  "openapi": "3.2.1",
  "paths": {
    "/events/stream": {
      "get": {
        "operationId": "events.stream",
        "parameters": [{ "in": "query", "name": "topic", "required": false, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "content": { "text/event-stream": { "schema": { "type": "string" } } },
            "description": "Event stream"
          }
        },
        "summary": "Stream events"
      }
    },
    "/items": {
      "get": {
        "operationId": "item.list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": { "items": { "items": { "type": "string" }, "type": "array" } },
                  "required": ["items"],
                  "type": "object"
                }
              }
            },
            "description": "ok"
          }
        }
      },
      "post": {
        "operationId": "item.create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "properties": { "name": { "type": "string" } }, "required": ["name"], "type": "object" }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": { "properties": { "id": { "type": "string" } }, "required": ["id"], "type": "object" }
              }
            },
            "description": "created"
          }
        }
      }
    }
  }
}
