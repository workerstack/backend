{
  "name": "backend-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/core",
      "packages/core/tests/e2e/*",
      "packages/core/tests/e2e/apps/*",
      "bench"
    ],
    "catalog": {
      "@cloudflare/workers-types": "5.20260710.1",
      "@playwright/test": "1.61.1",
      "@total-typescript/ts-reset": "0.6.1",
      "@types/node": "26.1.1",
      "arktype": "2.2.3",
      "effect": "3.21.4",
      "ts-morph": "28.0.0",
      "typescript": "7.0.2",
      "valibot": "1.4.2",
      "vite": "8.1.4",
      "vitest": "5.1.0",
      "wrangler": "4.157.0",
      "yup": "1.7.1",
      "zod": "4.3.6"
    }
  },
  "type": "module",
  "scripts": {
    "bench:finalize": "bun --cwd=bench run bench:finalize",
    "bench:hotpath": "bun --cwd=bench run bench:hotpath",
    "bench:middleware": "bun --cwd=bench run bench:middleware",
    "bench:streaming": "bun --cwd=bench run bench:streaming",
    "deploy:e2e:cf": "bun run --filter @backend/e2e-cf-workers deploy",
    "fmt": "repo fmt",
    "fmt:check": "repo fmt --check",
    "generate": "bun run --filter './packages/core/tests/e2e/apps/*' generate",
    "generate:check": "bun scripts/generate-check.ts",
    "lint": "repo lint",
    "lint:fix": "repo lint --fix",
    "postinstall": "repo sync --postinstall",
    "test": "bun run --filter @workerstack/backend --filter @backend/bench test",
    "test:bench": "bun run --filter @backend/bench test",
    "test:build": "bun --cwd=packages/core run test:build",
    "test:build:ci": "bun --cwd=packages/core run test:build:ci",
    "test:consumers": "bun test --conditions=backend-source packages/core/tests/e2e/apps/kitchen/tests/smoke.test.ts packages/core/tests/e2e/apps/defaults/tests/smoke.test.ts packages/core/tests/e2e/apps/compose/tests/smoke.test.ts packages/core/tests/e2e/apps/surface/tests/smoke.test.ts packages/core/tests/e2e/apps/gateway/tests/smoke.test.ts packages/core/tests/e2e/apps/mcp/tests/smoke.test.ts",
    "test:e2e": "bun --cwd=packages/core run test:e2e:cf",
    "test:e2e:cf": "bun --cwd=packages/core run test:e2e:cf",
    "test:e2e:cf:prod": "bun --cwd=packages/core run test:e2e:cf:prod",
    "test:live:cf": "bun run --filter @backend/e2e-cf-workers test:live",
    "test:packaging": "bun --cwd=packages/core run test:packaging",
    "test:v1": "vitest run --root packages/core --coverage",
    "typecheck": "bun run --filter @workerstack/backend --filter @backend/bench type:check",
    "typecheck:consumers": "bun run --filter './packages/core/tests/e2e/apps/*' --filter @backend/e2e-cf-workers type:check"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@total-typescript/ts-reset": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.1.0",
    "@workerstack/repo": "0.2.7",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
