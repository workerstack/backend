  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": true,
    "noEmit": false,
    "outDir": "./dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./src"
  },
  "exclude": ["src/**/*.test.ts", "src/**/__fixtures__/**"],
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts"]
}
