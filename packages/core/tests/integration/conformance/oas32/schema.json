{
  "$defs": {
    "callbacks": {
      "$comment": "https://spec.openapis.org/oas/v3.2#callback-object",
      "$ref": "#/$defs/specification-extensions",
      "additionalProperties": {
        "$ref": "#/$defs/path-item"
      },
      "type": "object"
    },
    "callbacks-or-reference": {
      "else": {
        "$ref": "#/$defs/callbacks"
      },
      "if": {
        "required": ["$ref"],
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/reference"
      }
    },
    "components": {
      "$comment": "https://spec.openapis.org/oas/v3.2#components-object",
      "$ref": "#/$defs/specification-extensions",
      "patternProperties": {
        "^(?:schemas|responses|parameters|examples|requestBodies|headers|securitySchemes|links|callbacks|pathItems|mediaTypes)$": {
          "$comment": "Enumerating all of the property names in the regex above is necessary for unevaluatedProperties to work as expected",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9._-]+$"
          }
        }
      },
      "properties": {
        "callbacks": {
          "additionalProperties": {
            "$ref": "#/$defs/callbacks-or-reference"
          },
          "type": "object"
        },
        "examples": {
          "additionalProperties": {
            "$ref": "#/$defs/example-or-reference"
          },
          "type": "object"
        },
        "headers": {
          "additionalProperties": {
            "$ref": "#/$defs/header-or-reference"
          },
          "type": "object"
        },
        "links": {
          "additionalProperties": {
            "$ref": "#/$defs/link-or-reference"
          },
          "type": "object"
        },
        "mediaTypes": {
          "additionalProperties": {
            "$ref": "#/$defs/media-type-or-reference"
          },
          "type": "object"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/parameter-or-reference"
          },
          "type": "object"
        },
        "pathItems": {
          "additionalProperties": {
            "$ref": "#/$defs/path-item"
          },
          "type": "object"
        },
        "requestBodies": {
          "additionalProperties": {
            "$ref": "#/$defs/request-body-or-reference"
          },
          "type": "object"
        },
        "responses": {
          "additionalProperties": {
            "$ref": "#/$defs/response-or-reference"
          },
          "type": "object"
        },
        "schemas": {
          "additionalProperties": {
            "$dynamicRef": "#meta"
          },
          "type": "object"
        },
        "securitySchemes": {
          "additionalProperties": {
            "$ref": "#/$defs/security-scheme-or-reference"
          },
          "type": "object"
        }
      },
      "type": "object",
      "unevaluatedProperties": false
    },
    "contact": {
      "$comment": "https://spec.openapis.org/oas/v3.2#contact-object",
      "$ref": "#/$defs/specification-extensions",
      "properties": {
        "email": {
          "format": "email",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "format": "uri-reference",
          "type": "string"
        }
      },
      "type": "object",
      "unevaluatedProperties": false
    },
    "content": {
      "$comment": "https://spec.openapis.org/oas/v3.2#fixed-fields-10",
      "additionalProperties": {
        "$ref": "#/$defs/media-type-or-reference"
      },
      "propertyNames": {
        "format": "media-range"
      },
      "type": "object"
    },
    "encoding": {
      "$comment": "https://spec.openapis.org/oas/v3.2#encoding-object",
      "allOf": [
        {
          "$ref": "#/$defs/specification-extensions"
        },
        {
          "$ref": "#/$defs/styles-for-form"
        }
      ],
      "dependentSchemas": {
        "allowReserved": {
          "properties": {
            "style": {
              "default": "form"
            }
          }
        },
        "encoding": {
          "properties": {
            "itemEncoding": false,
            "prefixEncoding": false
          }
        },
        "explode": {
          "properties": {
            "allowReserved": {
              "default": false
            },
            "style": {
              "default": "form"
            }
          }
        },
        "style": {
          "properties": {
            "allowReserved": {
              "default": false
            }
          }
        }
      },
      "properties": {
        "allowReserved": {
          "type": "boolean"
        },
        "contentType": {
          "format": "media-range",
          "type": "string"
        },
        "encoding": {
          "additionalProperties": {
            "$ref": "#/$defs/encoding"
          },
          "type": "object"
        },
        "explode": {
          "type": "boolean"
        },
        "headers": {
          "additionalProperties": {
            "$ref": "#/$defs/header-or-reference"
          },
          "type": "object"
        },
        "itemEncoding": {
          "$ref": "#/$defs/encoding"
        },
        "prefixEncoding": {
          "items": {
            "$ref": "#/$defs/encoding"
          },
          "type": "array"
        },
        "style": {
          "enum": ["form", "spaceDelimited", "pipeDelimited", "deepObject"]
        }
      },
      "type": "object",
      "unevaluatedProperties": false
    },
    "example": {
      "$comment": "https://spec.openapis.org/oas/v3.2#example-object",
      "$ref": "#/$defs/specification-extensions",
      "allOf": [
        {
          "not": {
            "required": ["value", "externalValue"]
          }
        },
        {
          "not": {
            "required": ["value", "dataValue"]
          }
        },
        {
          "not": {
            "required": ["value", "serializedValue"]
          }
        },
        {
          "not": {
            "required": ["serializedValue", "externalValue"]
          }
        }
      ],
      "properties": {
        "dataValue": true,
        "description": {
          "type": "string"
        },
        "externalValue": {
          "format": "uri-reference",
          "type": "string"
        },
        "serializedValue": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "value": true
      },
      "type": "object",
      "unevaluatedProperties": false
    },
    "example-or-reference": {
      "else": {
        "$ref": "#/$defs/example"
      },
      "if": {
        "required": ["$ref"],
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/reference"
      }
    },
    "examples": {
      "not": {
        "required": ["example", "examples"]
      },
      "properties": {
        "example": true,
        "examples": {
          "additionalProperties": {
            "$ref": "#/$defs/example-or-reference"
          },
          "type": "object"
        }
      }
    },
    "external-documentation": {
      "$comment": "https://spec.openapis.org/oas/v3.2#external-documentation-object",
      "$ref": "#/$defs/specification-extensions",
      "properties": {
        "description": {
          "type": "string"
        },
        "url": {
          "format": "uri-reference",
          "type": "string"
        }
      },
      "required": ["url"],
      "type": "object",
      "unevaluatedProperties": false
    },
    "header": {
      "$comment": "https://spec.openapis.org/oas/v3.2#header-object",
      "allOf": [
        {
          "$ref": "#/$defs/examples"
        },
        {
          "$ref": "#/$defs/specification-extensions"
        }
      ],
      "dependentSchemas": {
        "schema": {
          "properties": {
            "allowReserved": {
              "default": false,
              "type": "boolean"
            },
            "explode": {
              "default": false,
              "type": "boolean"
            },
            "style": {
              "const": "simple",
              "default": "simple"
            }
          }
        }
      },
      "oneOf": [
        {
          "required": ["schema"]
        },
        {
          "required": ["content"]
        }
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/content",
          "maxProperties": 1,
          "minProperties": 1
        },
        "deprecated": {
          "default": false,
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "schema": {
          "$dynamicRef": "#meta"
        }
      },
      "type": "object",
      "unevaluatedProperties": false
    },
    "header-or-reference": {
      "else": {
        "$ref": "#/$defs/header"
      },
      "if": {
        "required": ["$ref"],
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/reference"
      }
    },
    "info": {
      "$comment": "https://spec.openapis.org/oas/v3.2#info-object",
      "$ref": "#/$defs/specification-extensions",
      "properties": {
        "contact": {
          "$ref": "#/$defs/contact"
        },
        "description": {
          "type": "string"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "summary": {
          "type": "string"
        },
        "termsOfService": {
          "format": "uri-reference",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["title", "version"],
      "type": "object",
      "unevaluatedProperties": false
    },
    "license": {
      "$comment": "https://spec.openapis.org/oas/v3.2#license-object",
      "$ref": "#/$defs/specification-extensions",
      "dependentSchemas": {
        "identifier": {
          "not": {
            "required": ["url"]
          }
        }
      },
      "properties": {
        "identifier": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "format": "uri-reference",
          "type": "string"
        }
      },
      "required": ["name"],
      "type": "object",
      "unevaluatedProperties": false
    },
    "link": {
      "$comment": "https://spec.openapis.org/oas/v3.2#link-object",
      "$ref": "#/$defs/specification-extensions",
      "oneOf": [
        {
          "required": ["operationRef"]
        },
        {
          "required": ["operationId"]
        }
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "operationRef": {
          "format": "uri-reference",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/map-of-strings"
        },
        "requestBody": true,
        "server": {
          "$ref": "#/$defs/server"
        }
      },
      "type": "object",
      "unevaluatedProperties": false
    },
    "link-or-reference": {
      "else": {
        "$ref": "#/$defs/link"
      },
      "if": {
        "required": ["$ref"],
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/reference"
      }
    },
    "map-of-strings": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "media-type": {
      "$comment": "https://spec.openapis.org/oas/v3.2#media-type-object",
      "allOf": [
        {
          "$ref": "#/$defs/examples"
        },
        {
          "$ref": "#/$defs/specification-extensions"
        }
      ],
      "dependentSchemas": {
        "encoding": {
          "properties": {
            "itemEncoding": false,
            "prefixEncoding": false
          }
        }
      },
      "properties": {
        "description": {
          "type": "string"
        },
        "encoding": {
          "additionalProperties": {
            "$ref": "#/$defs/encoding"
          },
          "type": "object"
        },
        "itemEncoding": {
          "$ref": "#/$defs/encoding"
        },
        "itemSchema": {
          "$dynamicRef": "#meta"
        },
        "prefixEncoding": {
          "items": {
            "$ref": "#/$defs/encoding"
          },
          "type": "array"
        },
        "schema": {
          "$dynamicRef": "#meta"
        }
      },
      "type": "object",
      "unevaluatedProperties": false
    },
    "media-type-or-reference": {
      "else": {
        "$ref": "#/$defs/media-type"
      },
      "if": {
        "required": ["$ref"],
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/reference"
      }
    },
    "oauth-flows": {
      "$defs": {
        "authorization-code": {
          "$ref": "#/$defs/specification-extensions",
          "properties": {
            "authorizationUrl": {
              "format": "uri-reference",
              "type": "string"
            },
            "refreshUrl": {
              "format": "uri-reference",
              "type": "string"
            },
            "scopes": {
              "$ref": "#/$defs/map-of-strings"
            },
            "tokenUrl": {
              "format": "uri-reference",
              "type": "string"
            }
          },
          "required": ["authorizationUrl", "tokenUrl", "scopes"],
          "type": "object",
          "unevaluatedProperties": false
        },
        "client-credentials": {
          "$ref": "#/$defs/specification-extensions",
          "properties": {
            "refreshUrl": {
              "format": "uri-reference",
              "type": "string"
            },
            "scopes": {
              "$ref": "#/$defs/map-of-strings"
            },
            "tokenUrl": {
              "format": "uri-reference",
              "type": "string"
            }
          },
          "required": ["tokenUrl", "scopes"],
          "type": "object",
          "unevaluatedProperties": false
        },
        "device-authorization": {
          "$ref": "#/$defs/specification-extensions",
          "properties": {
            "deviceAuthorizationUrl": {
              "format": "uri-reference",
              "type": "string"
            },
            "refreshUrl": {
              "format": "uri-reference",
              "type": "string"
            },
            "scopes": {
              "$ref": "#/$defs/map-of-strings"
            },
            "tokenUrl": {
              "format": "uri-reference",
              "type": "string"
            }
          },
          "required": ["deviceAuthorizationUrl", "tokenUrl", "scopes"],
          "type": "object",
          "unevaluatedProperties": false
        },
        "implicit": {
          "$ref": "#/$defs/specification-extensions",
          "properties": {
            "authorizationUrl": {
              "format": "uri-reference",
              "type": "string"
            },
            "refreshUrl": {
              "format": "uri-reference",
              "type": "string"
            },
            "scopes": {
              "$ref": "#/$defs/map-of-strings"
            }
          },
          "required": ["authorizationUrl", "scopes"],
          "type": "object",
          "unevaluatedProperties": false
        },
        "password": {
          "$ref": "#/$defs/specification-extensions",
          "properties": {
            "refreshUrl": {
              "format": "uri-reference",
              "type": "string"
            },
            "scopes": {
              "$ref": "#/$defs/map-of-strings"
            },
            "tokenUrl": {
              "format": "uri-reference",
              "type": "string"
            }
          },
          "required": ["tokenUrl", "scopes"],
          "type": "object",
          "unevaluatedProperties": false
        }
      },
      "$ref": "#/$defs/specification-extensions",
      "properties": {
        "authorizationCode": {
          "$ref": "#/$defs/oauth-flows/$defs/authorization-code"
        },
        "clientCredentials": {
          "$ref": "#/$defs/oauth-flows/$defs/client-credentials"
        },
        "deviceAuthorization": {
          "$ref": "#/$defs/oauth-flows/$defs/device-authorization"
        },
        "implicit": {
          "$ref": "#/$defs/oauth-flows/$defs/implicit"
        },
        "password": {
          "$ref": "#/$defs/oauth-flows/$defs/password"
        }
      },
      "type": "object",
      "unevaluatedProperties": false
    },
    "operation": {
      "$comment": "https://spec.openapis.org/oas/v3.2#operation-object",
      "$ref": "#/$defs/specification-extensions",
      "properties": {
        "callbacks": {
          "additionalProperties": {
            "$ref": "#/$defs/callbacks-or-reference"
          },
          "type": "object"
        },
        "deprecated": {
          "default": false,
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "externalDocs": {
          "$ref": "#/$defs/external-documentation"
        },
        "operationId": {
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "requestBody": {
          "$ref": "#/$defs/request-body-or-reference"
        },
        "responses": {
          "$ref": "#/$defs/responses"
        },
        "security": {
          "items": {
            "$ref": "#/$defs/security-requirement"
          },
          "type": "array"
        },
        "servers": {
          "items": {
            "$ref": "#/$defs/server"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object",
      "unevaluatedProperties": false
    },
    "parameter": {
      "$comment": "https://spec.openapis.org/oas/v3.2#parameter-object",
      "allOf": [
        {
          "$ref": "#/$defs/examples"
        },
        {
          "$ref": "#/$defs/specification-extensions"
        },
        {
          "if": {
            "properties": {
              "in": {
                "const": "query"
              }
            }
          },
          "then": {
            "properties": {
              "allowEmptyValue": {
                "default": false,
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "in": {
                "const": "querystring"
              }
            }
          },
          "then": {
            "required": ["content"]
          }
        }
      ],
      "dependentSchemas": {
        "schema": {
          "$defs": {
            "styles-for-cookie": {
              "if": {
                "properties": {
                  "in": {
                    "const": "cookie"
                  }
                }
              },
              "then": {
                "properties": {
                  "style": {
                    "default": "form",
                    "enum": ["form", "cookie"]
                  }
                }
              }
            },
            "styles-for-header": {
              "if": {
                "properties": {
                  "in": {
                    "const": "header"
                  }
                }
              },
              "then": {
                "properties": {
                  "style": {
                    "const": "simple",
                    "default": "simple"
                  }
                }
              }
            },
            "styles-for-path": {
              "if": {
                "properties": {
                  "in": {
                    "const": "path"
                  }
                }
              },
              "then": {
                "properties": {
                  "required": {
                    "const": true
                  },
                  "style": {
                    "default": "simple",
                    "enum": ["matrix", "label", "simple"]
                  }
                },
                "required": ["required"]
              }
            },
            "styles-for-query": {
              "if": {
                "properties": {
                  "in": {
                    "const": "query"
                  }
                }
              },
              "then": {
                "properties": {
                  "style": {
                    "default": "form",
                    "enum": ["form", "spaceDelimited", "pipeDelimited", "deepObject"]
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/parameter/dependentSchemas/schema/$defs/styles-for-path"
            },
            {
              "$ref": "#/$defs/parameter/dependentSchemas/schema/$defs/styles-for-header"
            },
            {
              "$ref": "#/$defs/parameter/dependentSchemas/schema/$defs/styles-for-query"
            },
            {
              "$ref": "#/$defs/parameter/dependentSchemas/schema/$defs/styles-for-cookie"
            },
            {
              "$ref": "#/$defs/styles-for-form"
            }
          ],
          "properties": {
            "allowReserved": {
              "default": false,
              "type": "boolean"
            },
            "explode": {
              "type": "boolean"
            },
            "style": {
              "type": "string"
            }
          }
        }
      },
      "oneOf": [
        {
          "required": ["schema"]
        },
        {
          "required": ["content"]
        }
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/content",
          "maxProperties": 1,
          "minProperties": 1
        },
        "deprecated": {
          "default": false,
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "in": {
          "enum": ["query", "querystring", "header", "path", "cookie"]
        },
        "name": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "schema": {
          "$dynamicRef": "#meta"
        }
      },
      "required": ["name", "in"],
      "type": "object",
      "unevaluatedProperties": false
    },
    "parameter-or-reference": {
      "else": {
        "$ref": "#/$defs/parameter"
      },
      "if": {
        "required": ["$ref"],
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/reference"
      }
    },
    "parameters": {
      "contains": {
        "properties": {
          "in": {
            "const": "querystring"
          }
        },
        "required": ["in"],
        "type": "object"
      },
      "items": {
        "$ref": "#/$defs/parameter-or-reference"
      },
      "maxContains": 1,
      "minContains": 0,
      "not": {
        "allOf": [
          {
            "contains": {
              "properties": {
                "in": {
                  "const": "query"
                }
              },
              "required": ["in"],
              "type": "object"
            }
          },
          {
            "contains": {
              "properties": {
                "in": {
                  "const": "querystring"
                }
              },
              "required": ["in"],
              "type": "object"
            }
          }
        ]
      },
      "type": "array"
    },
    "path-item": {
      "$comment": "https://spec.openapis.org/oas/v3.2#path-item-object",
      "$ref": "#/$defs/specification-extensions",
      "properties": {
        "$ref": {
          "format": "uri-reference",
          "type": "string"
        },
        "additionalOperations": {
          "additionalProperties": {
            "$ref": "#/$defs/operation"
          },
          "propertyNames": {
            "$comment": "RFC9110 restricts methods to \"1*tchar\" in ABNF",
            "not": {
              "enum": ["GET", "PUT", "POST", "DELETE", "OPTIONS", "HEAD", "PATCH", "TRACE", "QUERY"]
            },
            "pattern": "^[a-zA-Z0-9!#$%&'*+.^_`|~-]+$"
          },
          "type": "object"
        },
        "delete": {
          "$ref": "#/$defs/operation"
        },
        "description": {
          "type": "string"
        },
        "get": {
          "$ref": "#/$defs/operation"
        },
        "head": {
          "$ref": "#/$defs/operation"
        },
        "options": {
          "$ref": "#/$defs/operation"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "patch": {
          "$ref": "#/$defs/operation"
        },
        "post": {
          "$ref": "#/$defs/operation"
        },
        "put": {
          "$ref": "#/$defs/operation"
        },
        "query": {
          "$ref": "#/$defs/operation"
        },
        "servers": {
          "items": {
            "$ref": "#/$defs/server"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        },
        "trace": {
          "$ref": "#/$defs/operation"
        }
      },
      "type": "object",
      "unevaluatedProperties": false
    },
    "paths": {
      "$comment": "https://spec.openapis.org/oas/v3.2#paths-object",
      "$ref": "#/$defs/specification-extensions",
      "patternProperties": {
        "^/": {
          "$ref": "#/$defs/path-item"
        }
      },
      "type": "object",
      "unevaluatedProperties": false
    },
    "reference": {
      "$comment": "https://spec.openapis.org/oas/v3.2#reference-object",
      "properties": {
        "$ref": {
          "format": "uri-reference",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "request-body": {
      "$comment": "https://spec.openapis.org/oas/v3.2#request-body-object",
      "$ref": "#/$defs/specification-extensions",
      "properties": {
        "content": {
          "$ref": "#/$defs/content"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": ["content"],
      "type": "object",
      "unevaluatedProperties": false
    },
    "request-body-or-reference": {
      "else": {
        "$ref": "#/$defs/request-body"
      },
      "if": {
        "required": ["$ref"],
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/reference"
      }
    },
    "response": {
      "$comment": "https://spec.openapis.org/oas/v3.2#response-object",
      "$ref": "#/$defs/specification-extensions",
      "properties": {
        "content": {
          "$ref": "#/$defs/content"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "$ref": "#/$defs/header-or-reference"
          },
          "type": "object"
        },
        "links": {
          "additionalProperties": {
            "$ref": "#/$defs/link-or-reference"
          },
          "type": "object"
        },
        "summary": {
          "type": "string"
        }
      },
      "type": "object",
      "unevaluatedProperties": false
    },
    "response-or-reference": {
      "else": {
        "$ref": "#/$defs/response"
      },
      "if": {
        "required": ["$ref"],
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/reference"
      }
    },
    "responses": {
      "$comment": "https://spec.openapis.org/oas/v3.2#responses-object",
      "$ref": "#/$defs/specification-extensions",
      "if": {
        "$comment": "either default, or at least one response code property must exist",
        "patternProperties": {
          "^[1-5](?:[0-9]{2}|XX)$": false
        }
      },
      "minProperties": 1,
      "patternProperties": {
        "^[1-5](?:[0-9]{2}|XX)$": {
          "$ref": "#/$defs/response-or-reference"
        }
      },
      "properties": {
        "default": {
          "$ref": "#/$defs/response-or-reference"
        }
      },
      "then": {
        "required": ["default"]
      },
      "type": "object",
      "unevaluatedProperties": false
    },
    "schema": {
      "$comment": "https://spec.openapis.org/oas/v3.2#schema-object",
      "$dynamicAnchor": "meta",
      "type": ["object", "boolean"]
    },
    "security-requirement": {
      "$comment": "https://spec.openapis.org/oas/v3.2#security-requirement-object",
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "security-scheme": {
      "$comment": "https://spec.openapis.org/oas/v3.2#security-scheme-object",
      "$defs": {
        "type-apikey": {
          "if": {
            "properties": {
              "type": {
                "const": "apiKey"
              }
            }
          },
          "then": {
            "properties": {
              "in": {
                "enum": ["query", "header", "cookie"]
              },
              "name": {
                "type": "string"
              }
            },
            "required": ["name", "in"]
          }
        },
        "type-http": {
          "if": {
            "properties": {
              "type": {
                "const": "http"
              }
            }
          },
          "then": {
            "properties": {
              "scheme": {
                "type": "string"
              }
            },
            "required": ["scheme"]
          }
        },
        "type-http-bearer": {
          "if": {
            "properties": {
              "scheme": {
                "pattern": "^[Bb][Ee][Aa][Rr][Ee][Rr]$",
                "type": "string"
              },
              "type": {
                "const": "http"
              }
            },
            "required": ["type", "scheme"]
          },
          "then": {
            "properties": {
              "bearerFormat": {
                "type": "string"
              }
            }
          }
        },
        "type-oauth2": {
          "if": {
            "properties": {
              "type": {
                "const": "oauth2"
              }
            }
          },
          "then": {
            "properties": {
              "flows": {
                "$ref": "#/$defs/oauth-flows"
              },
              "oauth2MetadataUrl": {
                "format": "uri-reference",
                "type": "string"
              }
            },
            "required": ["flows"]
          }
        },
        "type-oidc": {
          "if": {
            "properties": {
              "type": {
                "const": "openIdConnect"
              }
            }
          },
          "then": {
            "properties": {
              "openIdConnectUrl": {
                "format": "uri-reference",
                "type": "string"
              }
            },
            "required": ["openIdConnectUrl"]
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/specification-extensions"
        },
        {
          "$ref": "#/$defs/security-scheme/$defs/type-apikey"
        },
        {
          "$ref": "#/$defs/security-scheme/$defs/type-http"
        },
        {
          "$ref": "#/$defs/security-scheme/$defs/type-http-bearer"
        },
        {
          "$ref": "#/$defs/security-scheme/$defs/type-oauth2"
        },
        {
          "$ref": "#/$defs/security-scheme/$defs/type-oidc"
        }
      ],
      "properties": {
        "deprecated": {
          "default": false,
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "enum": ["apiKey", "http", "mutualTLS", "oauth2", "openIdConnect"]
        }
      },
      "required": ["type"],
      "type": "object",
      "unevaluatedProperties": false
    },
    "security-scheme-or-reference": {
      "else": {
        "$ref": "#/$defs/security-scheme"
      },
      "if": {
        "required": ["$ref"],
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/reference"
      }
    },
    "server": {
      "$comment": "https://spec.openapis.org/oas/v3.2#server-object",
      "$ref": "#/$defs/specification-extensions",
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "variables": {
          "additionalProperties": {
            "$ref": "#/$defs/server-variable"
          },
          "type": "object"
        }
      },
      "required": ["url"],
      "type": "object",
      "unevaluatedProperties": false
    },
    "server-variable": {
      "$comment": "https://spec.openapis.org/oas/v3.2#server-variable-object",
      "$ref": "#/$defs/specification-extensions",
      "properties": {
        "default": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "enum": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": ["default"],
      "type": "object",
      "unevaluatedProperties": false
    },
    "specification-extensions": {
      "$comment": "https://spec.openapis.org/oas/v3.2#specification-extensions",
      "patternProperties": {
        "^x-": true
      }
    },
    "styles-for-form": {
      "else": {
        "properties": {
          "explode": {
            "default": false
          }
        }
      },
      "if": {
        "properties": {
          "style": {
            "const": "form"
          }
        },
        "required": ["style"]
      },
      "then": {
        "properties": {
          "explode": {
            "default": true
          }
        }
      }
    },
    "tag": {
      "$comment": "https://spec.openapis.org/oas/v3.2#tag-object",
      "$ref": "#/$defs/specification-extensions",
      "properties": {
        "description": {
          "type": "string"
        },
        "externalDocs": {
          "$ref": "#/$defs/external-documentation"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": ["name"],
      "type": "object",
      "unevaluatedProperties": false
    }
  },
  "$id": "https://spec.openapis.org/oas/3.2/schema/2025-09-17",
  "$ref": "#/$defs/specification-extensions",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "required": ["paths"]
    },
    {
      "required": ["components"]
    },
    {
      "required": ["webhooks"]
    }
  ],
  "description": "The description of OpenAPI v3.2.x Documents without Schema Object validation",
  "properties": {
    "$self": {
      "$comment": "MUST NOT contain a fragment",
      "format": "uri-reference",
      "pattern": "^[^#]*$",
      "type": "string"
    },
    "components": {
      "$ref": "#/$defs/components"
    },
    "externalDocs": {
      "$ref": "#/$defs/external-documentation"
    },
    "info": {
      "$ref": "#/$defs/info"
    },
    "jsonSchemaDialect": {
      "default": "https://spec.openapis.org/oas/3.2/dialect/2025-09-17",
      "format": "uri-reference",
      "type": "string"
    },
    "openapi": {
      "pattern": "^3\\.2\\.\\d+(-.+)?$",
      "type": "string"
    },
    "paths": {
      "$ref": "#/$defs/paths"
    },
    "security": {
      "items": {
        "$ref": "#/$defs/security-requirement"
      },
      "type": "array"
    },
    "servers": {
      "default": [
        {
          "url": "/"
        }
      ],
      "items": {
        "$ref": "#/$defs/server"
      },
      "type": "array"
    },
    "tags": {
      "items": {
        "$ref": "#/$defs/tag"
      },
      "type": "array"
    },
    "webhooks": {
      "additionalProperties": {
        "$ref": "#/$defs/path-item"
      },
      "type": "object"
    }
  },
  "required": ["openapi", "info"],
  "type": "object",
  "unevaluatedProperties": false
}
