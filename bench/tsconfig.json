{
  "compilerOptions": {
    "customConditions": ["backend-source"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    // the benches compile packages/core/src, which is typed against the DOM lib (BodyInit, HeadersInit, FormDataEntryValue)
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  },
  "extends": "@workerstack/repo/tsconfig/bun",
  "include": ["src/**/*.ts"]
}
