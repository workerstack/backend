{
  "name": "@backend/e2e-kitchen",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "generate": "BUN_OPTIONS=--conditions=backend-source backend generate && BUN_OPTIONS=--conditions=backend-source clients generate --app src/gen-app.ts --target ts --ts-name Kitchen --out src/_gen/sdk",
    "test": "bun test --conditions=backend-source tests/smoke.test.ts",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@workerstack/backend": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@workerstack/clients": "1.0.0-rc.30",
    "typescript": "catalog:"
  }
}
